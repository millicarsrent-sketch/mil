Options -Indexes
RewriteEngine On

# ── HTTP → HTTPS canonical redirect ──────────────────────────────────────
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# ── www → non-www canonical redirect ─────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.millicars\.az$ [NC]
RewriteRule ^(.*)$ https://millicars.az/$1 [R=301,L]

# ── Old ?lang= parameter URLs (pre-multilang migration) ──────────────────
RewriteCond %{QUERY_STRING} ^lang=ru(&|$)
RewriteRule ^$ /ru/ [R=301,L]
RewriteCond %{QUERY_STRING} ^lang=en(&|$)
RewriteRule ^$ /en/ [R=301,L]
RewriteCond %{QUERY_STRING} ^lang=az(&|$)
RewriteRule ^$ /az/ [R=301,L]
RewriteCond %{QUERY_STRING} ^lang=
RewriteRule ^$ /en/ [R=301,L]


# ── Block Cloudflare email-protection (not our pages) ─────────────────────
RewriteRule ^cdn-cgi/ - [F,L]

# ── Short car URLs without /cars/ subfolder → correct path ───────────────
RewriteRule ^(ru|en|az)/(byd-destroyer|chevrolet-aveo|chevrolet-cobalt|chevrolet-spark|hyundai-accent|hyundai-creta|hyundai-elantra|hyundai-sonata|hyundai-staria|hyundai-tucson|hyundai-venue|kia-cerato|kia-rio|kia-sportage|mercedes-e-class|mercedes-vito|skoda-rapid|suzuki-swift|toyota-camry|toyota-corolla|toyota-rav4)/?$ /$1/cars/$2.html [R=301,L]

# ── Car URLs with -baku suffix → correct path ─────────────────────────────
RewriteRule ^(ru|en|az)/(byd-destroyer|chevrolet-aveo|chevrolet-cobalt|chevrolet-spark|hyundai-accent|hyundai-creta|hyundai-elantra|hyundai-sonata|hyundai-staria|hyundai-tucson|hyundai-venue|kia-cerato|kia-rio|kia-sportage|mercedes-e-class|mercedes-vito|skoda-rapid|suzuki-swift|toyota-camry|toyota-corolla|toyota-rav4)-baku\.html$ /$1/cars/$2.html [R=301,L]

# ── Old root-level pages (pre-multilang structure) → /ru/ ─────────────────
Redirect 301 /about.html          /ru/about.html
Redirect 301 /booking.html        /ru/booking.html
Redirect 301 /car-eclass.html     /ru/cars/mercedes-e-class.html
Redirect 301 /car-prado.html      /ru/cars.html
Redirect 301 /cars.html           /ru/cars.html
Redirect 301 /contacts.html       /ru/contacts.html
Redirect 301 /corporate.html      /ru/corporate.html
Redirect 301 /how-it-works.html   /ru/how-it-works.html
Redirect 301 /prices.html         /ru/cars.html
Redirect 301 /reviews.html        /ru/reviews.html
Redirect 301 /terms.html          /ru/terms.html

# ── Consolidated commercial intent: refundable deposit policy ─────────────
Redirect 301 /ru/car-rental-without-deposit-baku.html /ru/terms.html
Redirect 301 /en/car-rental-without-deposit-baku.html /en/terms.html
Redirect 301 /az/car-rental-without-deposit-baku.html /az/terms.html

# ── catalog.html → cars.html (EN/AZ) ─────────────────────────────────────
Redirect 301 /en/catalog.html     /en/cars.html
Redirect 301 /az/catalog.html     /az/cars.html

# ── routes-azerbaijan.html → routes.html ─────────────────────────────────
Redirect 301 /ru/routes-azerbaijan.html  /ru/routes.html

# ── Old /en/news/ pages → EN homepage ─────────────────────────────────────
RedirectMatch 301 ^/en/news/.*$   /en/

